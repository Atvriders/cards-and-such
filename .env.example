# Copy to .env and fill in real values.
# `docker compose up` reads .env automatically.

# Required in any non-local deployment. At least 16 chars.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Origin the browser will use when talking to the API. Must match the URL
# users actually open in their browser. Default matches the compose stack
# on localhost:8080.
CORS_ORIGIN=http://localhost:8080

# Host-side ports. Override if another service on the host already uses 4000/8080.
SERVER_PORT=4000
WEB_PORT=8080

# Image tag to pull. Pin to a commit short-sha for reproducibility.
# Example: IMAGE_TAG=master-c51e40d
IMAGE_TAG=latest
